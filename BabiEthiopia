    low:"Low stock",addDrug:"Add stock batch",drug:"Drug name",
    type:"Drug type",batch:"Batch number",expiryDate:"Expiry date",
    quantity:"Quantity",cost:"Unit purchase price",price:"Unit selling price",
    supplier:"Supplier",save:"Save",cancel:"Cancel",search:"Search medicines",
    sell:"Record sale",customer:"Customer",payment:"Payment received",
    cash:"Cash",credit:"Credit",product:"Product / batch",
    amount:"Quantity to sell",total:"Total",addCustomer:"Add customer",
    phone:"Phone",name:"Name",address:"Address",balance:"Customer debt",
    addPurchase:"Record purchase",expense:"Expenses",addExpense:"Add expense",
    description:"Description",date:"Date",profit:"Estimated gross profit",
    sold:"Sales history",inventory:"Current inventory",noData:"No records yet.",
    expired:"EXPIRED",near:"NEAR EXPIRY",ok:"OK",delete:"Delete",
