
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#176b45">
<title>Mulervet | Veterinary Wholesale</title>

<style>
:root {
  --green:#176b45;
  --light:#eaf5ee;
  --bg:#f5f7f6;
  --red:#c0392b;
  --orange:#b66b00;
}
* { box-sizing:border-box; }
body {
  margin:0;
  font-family:Arial,sans-serif;
  background:var(--bg);
  color:#202b25;
}
header {
  background:var(--green);
  color:white;
  padding:18px 16px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
}
header h2 { margin:0 0 5px; }
header small { color:#e0f2e7; }
button, input, select, textarea {
  font:inherit;
}
button {
  border:0;
  border-radius:8px;
  padding:10px 13px;
  cursor:pointer;
}
.primary { background:var(--green); color:white; }
.secondary { background:#e5eee8; color:var(--green); }
.danger { background:#fae7e5; color:var(--red); }
header button { background:white; color:var(--green); }
nav {
  display:flex;
  overflow-x:auto;
  gap:7px;
  padding:10px;
  background:white;
  border-bottom:1px solid #ddd;
}
nav button { white-space:nowrap; background:#eee; }
nav button.active { background:var(--green); color:white; }
main { padding:14px; max-width:1000px; margin:auto; }
h3 { margin-top:8px; }
.grid {
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:10px;
}
.card {
  background:white;
  border-radius:12px;
  padding:15px;
  box-shadow:0 1px 5px #0000000b;
  margin-bottom:12px;
  min-width:0;
}
.metric { font-size:22px; font-weight:bold; margin-top:8px; }
.muted { color:#68756d; font-size:13px; }
form { display:grid; gap:11px; }
label { display:grid; gap:5px; font-size:14px; }
input,select,textarea {
  width:100%;
  min-width:0;
  border:1px solid #ccd5cf;
  border-radius:8px;
  padding:11px;
  background:white;
  color:#202b25;
}
.row { display:flex; gap:8px; flex-wrap:wrap; }
.row > * { flex:1; }
.tablewrap { overflow-x:auto; }
table {
  border-collapse:collapse;
  width:100%;
  background:white;
  font-size:13px;
}
th,td {
  text-align:left;
  padding:10px;
  border-bottom:1px solid #e5e9e6;
  white-space:nowrap;
}
th { background:#edf4ef; }
.alert {
  border-left:4px solid var(--orange);
  padding:10px;
  background:#fff5df;
  border-radius:5px;
  margin:8px 0;
  font-size:14px;
}
.bad { color:var(--red); font-weight:bold; }
.good { color:var(--green); }
.hidden { display:none!important; }
footer { text-align:center; padding:20px; color:#68756d; font-size:12px; }
@media(min-width:650px) {
  .grid { grid-template-columns:repeat(4,minmax(0,1fr)); }
}
</style>
</head>

<body>
<header>
  <div>
    <h2>🐄 Mulervet</h2>
    <small id="subtitle">Veterinary Wholesale Manager</small>
  </div>
  <button onclick="toggleLanguage()" id="langBtn">አማርኛ</button>
</header>

<nav id="nav"></nav>
<main id="app"></main>
<footer>
  Mulervet • Veterinary Drug Wholesale Management<br>
  Local prototype — keep independent backups of important records.
</footer>

<script>
const $ = id => document.getElementById(id);
const money = n => Number(n || 0).toLocaleString(
  "en-ET",{maximumFractionDigits:2}
) + " ETB";

const translations = {
  en:{
    dashboard:"Dashboard",stock:"Drug Inventory",sales:"Sales",
    purchases:"Purchases",customers:"Customers",reports:"Reports",
    totalStock:"Stock purchase value",todaySales:"Today's sales",
