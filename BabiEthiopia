    all:"All",noStock:"No eligible stock available for sale.",
    saved:"Saved successfully.",badQty:"Insufficient stock or invalid quantity.",
    expiredBlock:"This batch is expired and cannot be sold.",
    stockWarning:"Stock and expiry alerts",export:"Export backup",
    restore:"Import backup",restoreHelp:"Import a previously exported JSON backup.",
    restoreConfirm:"Replace all current data with this backup?",
    settings:"Data & Backup",costNote:"Profit is estimated from recorded unit costs.",
    supplierList:"Suppliers",addSupplier:"Add supplier",
    employeeNote:"Employee accounts and cloud sync are not yet implemented.",
    deleteBatch:"Delete batch"
  },
  am:{
    dashboard:"ዳሽቦርድ",stock:"የመድኃኒት ክምችት",sales:"ሽያጭ",
    purchases:"ግዢዎች",customers:"ደንበኞች",reports:"ሪፖርቶች",
    totalStock:"የክምችት የግዢ ዋጋ",todaySales:"የዛሬ ሽያጭ",
    batches:"የክምችት ባች",expiry:"ያለፈበት / በቅርቡ የሚያልቅ",
    low:"ዝቅተኛ ክምችት",addDrug:"አዲስ ክምችት ጨምር",
    drug:"የመድኃኒት ስም",type:"የመድኃኒት ዓይነት",
    batch:"የባች ቁጥር",expiryDate:"የማለቂያ ቀን",
    quantity:"ብዛት",cost:"የአንዱ ግዢ ዋጋ",
    price:"የአንዱ ሽያጭ ዋጋ",supplier:"አቅራቢ",
    save:"አስቀምጥ",cancel:"ሰርዝ",search:"መድኃኒት ፈልግ",
    sell:"ሽያጭ መዝግብ",customer:"ደንበኛ",payment:"የተቀበልነው ክፍያ",
    cash:"በጥሬ ገንዘብ",credit:"በዱቤ",product:"ምርት / ባች",
    amount:"የሚሸጥ ብዛት",total:"ድምር",addCustomer:"ደንበኛ ጨምር",
    phone:"ስልክ",name:"ስም",address:"አድራሻ",balance:"የደንበኛ ዕዳ",
    addPurchase:"ግዢ መዝግብ",expense:"ወጪዎች",addExpense:"ወጪ ጨምር",
    description:"መግለጫ",date:"ቀን",profit:"ግምታዊ ጠቅላላ ትርፍ",
    sold:"የሽያጭ ታሪክ",inventory:"የአሁኑ ክምችት",
    noData:"ምንም መዝገብ የለም።",expired:"ጊዜው አልፏል",
    near:"ሊያልቅ ተቃርቧል",ok:"ጥሩ",delete:"ሰርዝ",
    confirmDelete:"ይህን መዝገብ ይሰረዝ?",
    dashboardTitle:"የንግድ ማጠቃለያ",
    category:"ምድብ",other:"ሌላ",unit:"ክፍል",medicine:"መድኃኒት",
    injection:"መርፌ",tablet:"ታብሌት",powder:"ዱቄት",liquid:"ፈሳሽ",
    vaccine:"ክትባት",antibiotic:"አንቲባዮቲክ",feed:"የመኖ ተጨማሪ",
    supplierName:"የአቅራቢ ስም",paid:"ተከፍሏል",unpaid:"አልተከፈለም",
    expensesTotal:"ጠቅላላ ወጪ",totalPurchases:"ጠቅላላ ግዢ",
    revenue:"የተመዘገበ የሽያጭ ገቢ",
    net:"ከወጪ በኋላ የሚገመት ትርፍ",
    all:"ሁሉም",noStock:"ለሽያጭ የሚበቃ ክምችት የለም።",
    expiredBlock:"ጊዜው ያለፈበት ባች መሸጥ አይቻልም።",
    saved:"ተቀምጧል።",badQty:"በቂ ክምችት የለም ወይም ብዛቱ ልክ አይደለም።",
    stockWarning:"የክምችትና የማለቂያ ማስጠንቀቂያዎች",
    export:"ባክአፕ አውርድ",restore:"ባክአፕ አስገባ",
    restoreHelp:"ቀድሞ የወጣ JSON ባክአፕ አስገባ።",
    restoreConfirm:"ያለው መረጃ በዚህ ባክአፕ ይተካ?",
    settings:"መረጃና ባክአፕ",
    costNote:"ትርፉ በተመዘገቡ የግዢ ዋጋዎች ይገመታል።",
    supplierList:"አቅራቢዎች",addSupplier:"አቅራቢ ጨምር",
    employeeNote:"የሰራተኛ መለያና የክላውድ ማመሳሰል ገና አልተሠሩም።",
    deleteBatch:"ባች ሰርዝ"
  }
};

let lang = localStorage.getItem("mv_lang") || "en";
let page = "dashboard";
let search = "";

const defaults = {
  batches:[], sales:[], purchases:[], customers:[],
  suppliers:[], expenses:[]
};
let db;
try {
  db = JSON.parse(localStorage.getItem("mulervet_db")) || defaults;
  for (const k in defaults) if (!Array.isArray(db[k])) db[k] = [];
} catch(e) {
  db = JSON.parse(JSON.stringify(defaults));
}

function t(key) {
  return (translations[lang] || translations.en)[key]
    || translations.en[key] || key;
}
function esc(s) {
  return String(s ?? "").replace(/[&<>"']/g,c=>({
    "&":"&amp;","<":"&lt;",">":"&gt;",
    '"':"&quot;","'":"&#39;"
  }[c]));
}
function save() {
  try {
    localStorage.setItem("mulervet_db",JSON.stringify(db));
    render();
  } catch(e) {
    alert("Could not save. Export your backup and free device storage.");
  }
}
function id() {
  return Date.now().toString(36)+Math.random().toString(36).slice(2,7);
}
function today() {
  const d=new Date();
  return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")
    +"-"+String(d.getDate()).padStart(2,"0");
}
function sum(list,fn) {
  return list.reduce((a,x)=>a+Number(fn(x)||0),0);
}
function isExpired(b) {
  return !!b.expiry && b.expiry < today();
}
function daysLeft(b) {
  if (!b.expiry) return Infinity;
  return Math.ceil((new Date(b.expiry+"T00:00:00")-
    new Date(today()+"T00:00:00"))/86400000);
}
function isNear(b) {
  return !isExpired(b) && daysLeft(b)<=90;
}
function available(b) {
  return Math.max(0,Number(b.qty)||0);
}
function sellable(b) {
  return !isExpired(b) && available(b)>0;
}
function activeBatches() {
  return db.batches.filter(sellable)
    .sort((a,b)=>(a.expiry||"9999").localeCompare(b.expiry||"9999"));
}
function stockValue() {
  return sum(db.batches,b=>b.qty*b.cost);
}
function revenue() {
  return sum(db.sales,s=>s.total);
}
function grossProfit() {
  return sum(db.sales,s=>s.profit);
}
function expenseTotal() {
  return sum(db.expenses,e=>e.amount);
}
function netProfit() {
  return grossProfit()-expenseTotal();
}
function todayRevenue() {
  return sum(db.sales.filter(s=>s.date===today()),s=>s.total);
}
function customerName(id) {
  return db.customers.find(c=>c.id===id)?.name || "Walk-in";
}
function batchName(b) {
  return b.drug+" · "+(b.batch||"No batch")+" · "+(b.expiry||"No expiry");
}
function field(label,name,type="text",required=true,value="") {
  return `<label>${label}<input name="${name}" type="${type}"
    ${required?"required":""} value="${esc(value)}"></label>`;
}
function selectField(label,name,options,required=true) {
  return `<label>${label}<select name="${name}" ${required?"required":""}>
    ${options.map(o=>`<option value="${esc(o.value)}">${esc(o.label)}</option>`).join("")}
    </select></label>`;
}
function nav() {
  const pages=["dashboard","stock","sales","purchases","customers","reports","settings"];
  $("nav").innerHTML=pages.map(p=>
    `<button class="${page===p?"active":""}" onclick="go('${p}')">${t(p)}</button>`
  ).join("");
}
function go(p) {
  page=p;
  render();
}
function metric(label,value) {
  return `<div class="card"><div class="muted">${label}</div>
    <div class="metric">${value}</div></div>`;
}
function table(headers,rows) {
  if(!rows.length) return `<p class="muted">${t("noData")}</p>`;
  return `<div class="tablewrap"><table><thead><tr>${
    headers.map(h=>`<th>${h}</th>`).join("")
  }</tr></thead><tbody>${rows.map(r=>`<tr>${r.map(c=>`<td>${c}</td>`).join("")}</tr>`).join("")}</tbody></table></div>`;
}
function dashboard() {
  const alerts=db.batches.filter(b=>available(b)>0&&(isExpired(b)||isNear(b)));
  const low=db.batches.filter(b=>available(b)>0&&available(b)<=5&&!isExpired(b));
  return `<h3>${t("dashboardTitle")}</h3>
    <div class="grid">
      ${metric(t("totalStock"),money(stockValue()))}
      ${metric(t("todaySales"),money(todayRevenue()))}
      ${metric(t("batches"),db.batches.length)}
      ${metric(t("profit"),money(grossProfit()))}
    </div>
    <div class="card"><h3>${t("stockWarning")}</h3>
      ${alerts.length?alerts.map(b=>`<div class="alert">
        <strong>${esc(b.drug)}</strong> — ${esc(b.batch||"-")}
        <br>${isExpired(b)?`<span class="bad">${t("expired")}</span>`:
        `<span style="color:#a65d00">${t("near")}: ${daysLeft(b)} days</span>`}
        <br>${esc(b.expiry||"-")} · ${t("quantity")}: ${available(b)}
      </div>`).join(""):t("noData")}
      ${low.length?`<h4>${t("low")}</h4>`+low.map(b=>`<p>${esc(b.drug)}: ${available(b)}</p>`).join(""):""}
    </div>
    <div class="card"><h3>${t("employeeNote")}</h3>
      <p class="muted">${t("costNote")}</p>
    </div>`;
}
function stock() {
  const list=db.batches.filter(b=>
    (b.drug+" "+b.type+" "+b.batch+" "+b.supplier)
      .toLowerCase().includes(search.toLowerCase()));
  return `<h3>${t("stock")}</h3>
    <div class="card"><h3>${t("addDrug")}</h3>
      <form id="stockForm">
        ${field(t("drug"),"drug")}
        ${selectField(t("type"),"type",[
          {value:"Medicine",label:t("medicine")},
          {value:"Injection",label:t("injection")},
          {value:"Tablet",label:t("tablet")},
          {value:"Powder",label:t("powder")},
          {value:"Liquid",label:t("liquid")},
          {value:"Vaccine",label:t("vaccine")},
          {value:"Antibiotic",label:t("antibiotic")},
          {value:"Feed supplement",label:t("feed")},
          {value:"Other",label:t("other")}
        ])}
        ${field(t("batch"),"batch")}
        <div class="row">
          ${field(t("expiryDate"),"expiry","date")}
          ${field(t("quantity"),"qty","number")}
        </div>
        <div class="row">
          ${field(t("cost"),"cost","number")}
          ${field(t("price"),"price","number")}
        </div>
        ${field(t("supplier"),"supplier", "text",false)}
        <button class="primary">${t("save")}</button>
      </form>
    </div>
    <div class="card">
      <input placeholder="${t("search")}" value="${esc(search)}"
        oninput="search=this.value;render()">
      <h3>${t("inventory")}</h3>
      ${table([t("drug"),t("batch"),t("expiryDate"),t("quantity"),
        t("cost"),t("price"),"Status",t("delete")],
        list.map(b=>[
          esc(b.drug)+"<br><span class='muted'>"+esc(b.type)+"</span>",
          esc(b.batch||"-"),esc(b.expiry||"-"),available(b),
          money(b.cost),money(b.price),
          isExpired(b)?`<span class="bad">${t("expired")}</span>`:
          isNear(b)?t("near"):t("ok"),
          `<button class="danger" onclick="deleteBatch('${b.id}')">${t("delete")}</button>`
        ]))}
    </div>`;
}
function sales() {
  const batches=activeBatches();
  return `<h3>${t("sales")}</h3>
    <div class="card"><h3>${t("sell")}</h3>
      ${batches.length?`<form id="saleForm">
        ${selectField(t("product"),"batchId",batches.map(b=>({
          value:b.id,label:batchName(b)+" ("+available(b)+")"
        })))}
        ${selectField(t("customer"),"customerId",[
          {value:"",label:"Walk-in"}
        ].concat(db.customers.map(c=>({value:c.id,label:c.name})),[] ,true)}
        ${field(t("amount"),"qty","number")}
        ${field(t("payment"),"paid","number",true,"0")}
        ${selectField(t("payment"),"method",[
          {value:"Cash",label:t("cash")},
          {value:"Credit",label:t("credit")}
        ])}
        <button class="primary">${t("sell")}</button>
      </form>`:`<p>${t("noStock")}</p>`}
    </div>
    <div class="card"><h3>${t("sold")}</h3>
      ${table([t("date"),t("drug"),t("customer"),t("amount"),
        t("total"),t("payment")],db.sales.slice().reverse().map(s=>[
        esc(s.date),esc(s.drug),esc(customerName(s.customerId)),
        s.qty,money(s.total),money(s.paid)
      ]))}
    </div>`;
}
function purchases() {
  return `<h3>${t("purchases")}</h3>
    <div class="card">
      <p>To receive stock, use <strong>${t("stock")}</strong> and enter the
      new batch, quantity, supplier, expiry date and unit cost. This records
      the inventory batch and purchase cost.</p>
      <h3>${t("supplierList")}</h3>
      <form id="supplierForm">
        ${field(t("supplierName"),"name")}
        ${field(t("phone"),"phone","tel",false)}
        <button class="primary">${t("addSupplier")}</button>
      </form>
      ${table([t("supplierName"),t("phone"),t("delete")],
        db.suppliers.map(s=>[esc(s.name),esc(s.phone||"-"),
          `<button class="danger" onclick="removeItem('suppliers','${s.id}')">${t("delete")}</button>`]))}
    </div>
    <div class="card"><h3>${t("expense")}</h3>
      <form id="expenseForm">
        ${field(t("description"),"description")}
        ${field(t("amount"),"amount","number")}
        ${field(t("date"),"date","date",true,today())}
        <button class="primary">${t("addExpense")}</button>
      </form>
      ${table([t("date"),t("description"),t("amount"),t("delete")],
        db.expenses.map(e=>[esc(e.date),esc(e.description),money(e.amount),
          `<button class="danger" onclick="removeItem('expenses','${e.id}')">${t("delete")}</button>`]))}
    </div>`;
}
function customers() {
  return `<h3>${t("customers")}</h3>
    <div class="card"><h3>${t("addCustomer")}</h3>
      <form id="customerForm">
        ${field(t("name"),"name")}
        ${field(t("phone"),"phone","tel",false)}
        ${field(t("address"),"address","text",false)}
        <button class="primary">${t("save")}</button>
      </form>
    </div>
    <div class="card">${table([t("name"),t("phone"),t("address"),
      t("balance"),t("delete")],db.customers.map(c=>{
        const debt=sum(db.sales.filter(s=>s.customerId===c.id),s=>s.total-s.paid);
        return [esc(c.name),esc(c.phone||"-"),esc(c.address||"-"),
          money(debt),`<button class="danger" onclick="removeItem('customers','${c.id}')">${t("delete")}</button>`];
      }))}</div>`;
}
function reports() {
  return `<h3>${t("reports")}</h3>
    <div class="grid">
      ${metric(t("revenue"),money(revenue()))}
      ${metric(t("totalPurchases"),money(sum(db.batches,b=>b.qty*b.cost)))}
      ${metric(t("expensesTotal"),money(expenseTotal()))}
      ${metric(t("net"),money(netProfit()))}
    </div>
    <div class="card"><p class="muted">${t("costNote")}</p>
      <h3>${t("sold")}</h3>
      ${table([t("date"),t("drug"),t("amount"),t("total"),"Gross profit"],
        db.sales.map(s=>[esc(s.date),esc(s.drug),s.qty,money(s.total),money(s.profit)]))}
    </div>`;
}
function settings() {
  return `<h3>${t("settings")}</h3>
    <div class="card">
      <h3>${t("export")}</h3>
      <p class="muted">Download all saved data as a JSON file. Keep the file private.</p>
      <button class="primary" onclick="exportData()">${t("export")}</button>
    </div>
    <div class="card">
      <h3>${t("restore")}</h3>
      <p class="muted">${t("restoreHelp")}</p>
      <input id="backupFile" type="file" accept=".json,application/json">
      <button class="primary" onclick="importData()">${t("restore")}</button>
    </div>
    <div class="card">
      <h3>About Mulervet</h3>
      <p>This prototype saves records in this browser on this device.
      Clearing browser data may delete your records. It does not provide
      cloud synchronization or employee logins.</p>
      <p>Do not sell expired, recalled, or otherwise restricted products.
      Verify veterinary medicine licensing and handling requirements
      applicable to your business.</p>
    </div>`;
}
function render() {
  nav();
  const pages={
    dashboard,stock,sales,purchases,customers,reports,settings
  };
  $("app").innerHTML=pages[page]();
  $("subtitle").textContent=lang==="am"
    ?"የእንስሳት መድኃኒት ጅምላ ንግድ አስተዳደር"
    :"Veterinary Wholesale Manager";
  $("langBtn").textContent=lang==="en"?"አማርኛ":"English";
  bindForms();
}
function bindForms() {
  const sf=$("stockForm");
  if(sf) sf.onsubmit=e=>{
    e.preventDefault();
    const f=new FormData(sf);
    const qty=Number(f.get("qty")),cost=Number(f.get("cost")),
      price=Number(f.get("price"));
    if(qty<=0||cost<0||price<0) return alert(t("badQty"));
    db.batches.push({
      id:id(),drug:f.get("drug").trim(),type:f.get("type"),
      batch:f.get("batch").trim(),expiry:f.get("expiry"),
      qty,cost,price,supplier:f.get("supplier").trim(),
      added:today()
    });
    save();alert(t("saved"));
  };
  const sale=$("saleForm");
  if(sale) sale.onsubmit=e=>{
    e.preventDefault();
    const f=new FormData(sale),b=db.batches.find(x=>x.id===f.get("batchId"));
    const qty=Number(f.get("qty")),paid=Number(f.get("paid"));
    if(!b||isExpired(b)) return alert(t("expiredBlock"));
    if(qty<=0||qty>available(b)||paid<0) return alert(t("badQty"));
    const total=qty*Number(b.price);
    if(paid>total) return alert("Payment cannot exceed invoice total.");
    b.qty-=qty;
    db.sales.push({
      id:id(),date:today(),batchId:b.id,drug:b.drug,qty,
      total,paid,method:f.get("method"),
      customerId:f.get("customerId")||"",
      profit:qty*(Number(b.price)-Number(b.cost))
    });
    save();alert(t("saved"));
  };
  const cf=$("customerForm");
  if(cf) cf.onsubmit=e=>{
    e.preventDefault();const f=new FormData(cf);
    db.customers.push({id:id(),name:f.get("name").trim(),
      phone:f.get("phone"),address:f.get("address")});
    save();alert(t("saved"));
  };
  const pf=$("supplierForm");
  if(pf) pf.onsubmit=e=>{
    e.preventDefault();const f=new FormData(pf);
    db.suppliers.push({id:id(),name:f.get("name").trim(),phone:f.get("phone")});
    save();alert(t("saved"));
  };
  const ef=$("expenseForm");
  if(ef) ef.onsubmit=e=>{
    e.preventDefault();const f=new FormData(ef),amount=Number(f.get("amount"));
    if(amount<=0) return alert(t("badQty"));
    db.expenses.push({id:id(),description:f.get("description"),
      amount,date:f.get("date")});
    save();alert(t("saved"));
  };
}
function deleteBatch(id) {
  const b=db.batches.find(x=>x.id===id);
  if(!b||!confirm(t("confirmDelete"))) return;
  if(db.sales.some(s=>s.batchId===id)) {
    return alert("This batch has sales history. Do not delete it; use an adjustment workflow instead.");
  }
  db.batches=db.batches.filter(x=>x.id!==id);
  save();
}
function removeItem(collection,id) {
  if(!confirm(t("confirmDelete"))) return;
  db[collection]=db[collection].filter(x=>x.id!==id);
  save();
}
function toggleLanguage() {
  lang=lang==="en"?"am":"en";
  localStorage.setItem("mv_lang",lang);
  render();
}
function exportData() {
  const blob=new Blob([JSON.stringify({
    version:1,exported:new Date().toISOString(),db
  },null,2)],{type:"application/json"});
  const a=document.createElement("a");
  a.href=URL.createObjectURL(blob);
  a.download="mulervet-backup-"+today()+".json";
  a.click();
  setTimeout(()=>URL.revokeObjectURL(a.href),1000);
}
function importData() {
  const file=$("backupFile").files[0];
  if(!file) return alert("Choose a JSON backup file first.");
  if(!confirm(t("restoreConfirm"))) return;
  const reader=new FileReader();
  reader.onload=()=>{
    try {
      const obj=JSON.parse(reader.result);
      const incoming=obj.db||obj;
      for(const k in defaults) {
        if(!Array.isArray(incoming[k])) throw Error("Invalid backup");
      }
      db=incoming;
      save();
      alert(t("saved"));
    } catch(e) {
      alert("Invalid backup file. Your existing data was not replaced.");
    }
  };
  reader.readAsText(file);
}
render();
</script>
</body>
</html>
